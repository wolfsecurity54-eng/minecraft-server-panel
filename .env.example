# ============================================================================
# Minecraft Server Control Panel - Environment Variables
# ============================================================================

# ----- Web-Panel -----
PANEL_PORT=3000
NODE_ENV=production
SESSION_SECRET=change-this-to-a-random-32-char-secret

# ----- Java -----
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# ----- Server Defaults -----
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password

# ============================================================================
# RAILWAY DEPLOYMENT (Auto-Set by Railway)
# ============================================================================

# Wird automatisch von Railway gesetzt:
# RAILWAY_PROJECT_ID=xxxxx
# RAILWAY_SERVICE_ID=xxxxx
# RAILWAY_ENVIRONMENT_ID=xxxxx
# RAILWAY_PUBLIC_DOMAIN=xxx.up.railway.app
# RAILWAY_STATIC_URL=...

# Manuell setzen (https://railway.app/account/tokens):
# Format: railway_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ACHTUNG: NIEMALS in Git committen!
RAILWAY_API_KEY=

# Optional: Deploy-Hook (Alternative zu API-Token)
# RAILWAY_DEPLOY_HOOK=https://api.railway.app/hooks/xxxxx

# Optional: Git-Repository für Auto-Deploy
RAILWAY_GIT_REPO=https://github.com/user/minecraft-panel.git
RAILWAY_GIT_BRANCH=main

# ============================================================================
# MINECRAFT SERVER
# ============================================================================

# Minecraft-spezifische Einstellungen
# (Diese können auch über das Web-Panel konfiguriert werden)
MC_SERVER_PORT=25565
MC_BEDROCK_PORT=19132
MC_RAM_MIN=512M
MC_RAM_MAX=2G
MC_MAX_PLAYERS=20

# ============================================================================
# SECURITY
# ============================================================================

# Brute-Force-Schutz
SEC_LOGIN_ATTEMPTS=5
SEC_LOGIN_LOCKOUT_MIN=15

# IP-Ban
SEC_IP_BAN_ENABLED=true
SEC_MAX_ACCOUNTS_PER_IP=3

# Anti-Cheat
SEC_ANTICHEAT_AUTOBAN=true
SEC_ANTICHEAT_BAN_THRESHOLD=10
SEC_ANTICHEAT_KICK_THRESHOLD=5

# 2FA für Owner
SEC_2FA_ENABLED=false

# Connection-Limit (DDoS-Schutz)
SEC_MAX_CONNECTIONS_PER_IP=3
SEC_CONNECTION_RATE_LIMIT=10
